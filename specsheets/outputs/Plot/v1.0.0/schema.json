{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/outputs/Plot/v1.0.0/schema.json",
  "title": "SED2 Plot",
  "$defs": {
    "Plot": {
