{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/outputs/Plot3D/v1.0.0/schema.json",
  "title": "SED2 Plot3D",
  "$defs": {
    "Plot3D": {
      "description": "A 3D plot with one or more surfaces.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../outputs/Plot/v1.0.0/schema.json#/$defs/Plot"
        }
      ],
      "properties": {
        "_type": {
          "const": "plot3D",
          "x-rule-id": "Plot3D-0004"
        },
        "zAxis": {
          "$ref": "../../../auxiliary/Axis/v1.0.0/schema.json#/$defs/Axis",
          "x-rule-id": "Plot3D-0003"
        },
        "surfaces": {
          "type": "object",
          "propertyNames": {
            "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SId"
          },
          "additionalProperties": {
            "$ref": "../../../outputs/Surface/v1.0.0/schema.json#/$defs/Surface"
          },
          "x-rule-id": "Plot3D-0002"
        }
      },
      "required": [
        "_type",
        "surfaces"
      ],
      "x-required-rule-ids": {
        "surfaces": "Plot3D-0001"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Plot3D"
}
