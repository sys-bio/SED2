{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/outputs/Surface/v1.0.0/schema.json",
  "title": "SED2 Surface",
  "$defs": {
    "Surface": {
      "description": "A 3D surface on a Plot3D.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        }
      ],
      "properties": {
        "surfaceType": {
          "anyOf": [
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SurfaceType"
            },
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
            }
          ]
        },
        "x": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
        },
        "y": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
        },
        "z": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
        },
        "style": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Surface-0010"
        },
        "order": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NonNegativeIntegerOrRef",
          "x-rule-id": [
            "Surface-0011",
            "Surface-0012"
          ]
        }
      },
      "required": [
        "surfaceType",
        "x",
        "y",
        "z"
      ],
      "x-required-rule-ids": {
        "surfaceType": "Surface-0001",
        "x": "Surface-0004",
        "y": "Surface-0006",
        "z": "Surface-0008"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Surface"
}
