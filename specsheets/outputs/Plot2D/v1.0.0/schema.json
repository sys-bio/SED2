{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/outputs/Plot2D/v1.0.0/schema.json",
  "title": "SED2 Plot2D",
  "$defs": {
    "Plot2D": {
      "description": "A 2D plot with one or more curves.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../outputs/Plot/v1.0.0/schema.json#/$defs/Plot"
        }
      ],
      "properties": {
        "_type": {
          "const": "plot2D",
          "x-rule-id": "Plot2D-0004"
        },
        "rightYAxis": {
          "$ref": "../../../auxiliary/Axis/v1.0.0/schema.json#/$defs/Axis",
          "x-rule-id": "Plot2D-0003"
        },
        "curves": {
          "type": "object",
          "propertyNames": {
            "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SId"
          },
          "additionalProperties": {
            "$ref": "../../../auxiliary/AbstractCurve/v1.0.0/schema.json#/$defs/AbstractCurve"
          },
          "x-rule-id": "Plot2D-0002"
        }
      },
      "required": [
        "_type",
        "curves"
      ],
      "x-required-rule-ids": {
        "curves": "Plot2D-0001"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Plot2D"
}
