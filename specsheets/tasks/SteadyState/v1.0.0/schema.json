{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/SteadyState/v1.0.0/schema.json",
  "title": "SED2 SteadyState",
  "$defs": {
    "SteadyState": {
      "description": "Compute the steady state of a model.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../tasks/AbstractTask/v1.0.0/common.schema.json#/$defs/AbstractTaskCommon"
        }
      ],
      "properties": {
        "_type": {
          "const": "steadyState",
          "x-rule-id": "SteadyState-0003"
        },
        "model": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-ref-target": "model"
        },
        "independentVariable": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/StringOrRef",
          "x-rule-id": "SteadyState-0004"
        },
        "outputVariables": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/ListOfStringsOrRef"
        },
        "workingAlgorithms": {
          "type": "array",
          "items": {
            "$ref": "../../../auxiliary/WorkingAlgorithm/v1.0.0/schema.json#/$defs/WorkingAlgorithm"
          },
          "x-rule-id": "SteadyState-0007"
        }
      },
      "required": [
        "_type",
        "model",
        "outputVariables"
      ],
      "x-required-rule-ids": {
        "model": "SteadyState-0001",
        "outputVariables": "SteadyState-0002"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/SteadyState"
}
