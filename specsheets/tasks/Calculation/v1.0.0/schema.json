{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/Calculation/v1.0.0/schema.json",
  "title": "SED2 Calculation",
  "$defs": {
    "Calculation": {
      "description": "Perform an infix calculation defined in `math`.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        },
        {
          "$ref": "../../../tasks/AbstractTask/v1.0.0/common.schema.json#/$defs/AbstractTaskCommon"
        }
      ],
      "properties": {
        "_type": {
          "const": "calculation",
          "x-rule-id": "Calculation-0004"
        },
        "math": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/StringOrRef"
        }
      },
      "required": [
        "_type",
        "math"
      ],
      "x-required-rule-ids": {
        "math": "Calculation-0001"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Calculation"
}
