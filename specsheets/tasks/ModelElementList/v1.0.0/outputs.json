{
  "outputs": {
    "[id].strings": {
      "type": "stringList",
      "dimensions": [
        {
          "size": {
            "source": "input-file",
            "from": "model",
            "extract": "matchedElementIds",
            "note": "length = number of elements in the referenced model matched after includeElements/includeTypes/excludeElements/excludeTypes filtering"
          },
          "labels": {
            "source": "input-file",
            "from": "model",
            "extract": "matchedElementIds",
            "note": "the matched element ids themselves"
          }
        }
      ]
    }
  }
}
