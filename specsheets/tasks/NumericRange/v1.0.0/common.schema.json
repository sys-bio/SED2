{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/NumericRange/v1.0.0/common.schema.json",
  "title": "SED2 NumericRangeCommon",
  "$defs": {
    "NumericRangeCommon": {
      "description": "Fields inherited by every NumericRange subtype (in addition to Range). Used via allOf. Narrows values to numeric-only.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../tasks/Range/v1.0.0/common.schema.json#/$defs/RangeCommon"
        }
      ],
      "properties": {
        "start": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "NumericRange-0001",
            "NumericRange-0002"
          ]
        },
        "end": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "NumericRange-0003",
            "NumericRange-0004"
          ]
        },
        "interval": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/PositiveDoubleOrRef",
          "x-rule-id": [
            "NumericRange-0005",
            "NumericRange-0006"
          ]
        },
        "numberOfSteps": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/PositiveIntegerOrRef",
          "x-rule-id": [
            "NumericRange-0007",
            "NumericRange-0008"
          ]
        },
        "scale": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/ScaleTypeOrRef",
          "x-rule-id": [
            "NumericRange-0009",
            "NumericRange-0010"
          ]
        },
        "values": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef"
              }
            },
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
            }
          ],
          "x-rule-id": [
            "NumericRange-0011",
            "NumericRange-0012"
          ]
        }
      }
    }
  },
  "$ref": "#/$defs/NumericRangeCommon"
}
