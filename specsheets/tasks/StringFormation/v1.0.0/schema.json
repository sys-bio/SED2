{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/StringFormation/v1.0.0/schema.json",
  "title": "SED2 StringFormation",
  "$defs": {
    "StringFormation": {
      "description": "Concatenate strings (and stringified numbers/lists) into a single string or list of strings.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        },
        {
          "$ref": "../../../tasks/AbstractTask/v1.0.0/common.schema.json#/$defs/AbstractTaskCommon"
        }
      ],
      "properties": {
        "_type": {
          "const": "stringFormation"
        },
        "concatenate": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/ListOfAnyOrRef"
        }
      },
      "required": [
        "_type",
        "concatenate"
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/StringFormation"
}
