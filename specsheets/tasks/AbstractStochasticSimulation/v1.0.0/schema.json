{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/AbstractStochasticSimulation/v1.0.0/schema.json",
  "title": "SED2 AbstractStochasticSimulation",
  "$defs": {
    "AbstractStochasticSimulation": {
      "description": "Stochastic-solver tuning fields shared by ExplicitStochasticSimulation, BoundedStochasticSimulation, and OneStepStochasticSimulation. A schema-only mixin composed via allOf; never instantiated on its own, no _type or diagram box of its own.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../tasks/AbstractSimulation/v1.0.0/schema.json#/$defs/AbstractSimulation"
        }
      ],
      "properties": {
        "seed": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0001",
            "AbstractStochasticSimulation-0002"
          ]
        },
        "timeDependentRelativeTolerance": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0003",
            "AbstractStochasticSimulation-0004"
          ]
        },
        "variableStepSize": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/BooleanOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0005",
            "AbstractStochasticSimulation-0006"
          ]
        },
        "minimumTimeStep": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0007",
            "AbstractStochasticSimulation-0008"
          ]
        },
        "maximumTimeStep": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0009",
            "AbstractStochasticSimulation-0010"
          ]
        },
        "nonNegative": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/BooleanOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0011",
            "AbstractStochasticSimulation-0012"
          ]
        },
        "maxOutputRows": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/PositiveIntegerOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0013",
            "AbstractStochasticSimulation-0014"
          ]
        },
        "maxNumSteps": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/PositiveIntegerOrRef",
          "x-rule-id": [
            "AbstractStochasticSimulation-0015",
            "AbstractStochasticSimulation-0016"
          ]
        }
      }
    }
  },
  "$ref": "#/$defs/AbstractStochasticSimulation"
}
