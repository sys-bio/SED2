{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/RelabelData/v1.0.0/schema.json",
  "title": "SED2 RelabelData",
  "$defs": {
    "RelabelData": {
      "description": "Replace the labels of the topmost dimension of a referenced AnnotatedData.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        },
        {
          "$ref": "../../../tasks/AbstractTask/v1.0.0/common.schema.json#/$defs/AbstractTaskCommon"
        }
      ],
      "properties": {
        "_type": {
          "const": "relabelData"
        },
        "input": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
        },
        "labels": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/ListOfStringsOrRef"
        }
      },
      "required": [
        "_type",
        "input",
        "labels"
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/RelabelData"
}
