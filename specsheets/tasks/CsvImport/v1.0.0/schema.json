{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/CsvImport/v1.0.0/schema.json",
  "title": "SED2 CsvImport",
  "$defs": {
    "CsvImport": {
      "description": "Import a CSV (or other delimiter-separated values) file as an AnnotatedData(numbers). The id of the task refers to the imported data.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        },
        {
          "$ref": "../../../tasks/AbstractTask/v1.0.0/common.schema.json#/$defs/AbstractTaskCommon"
        }
      ],
      "properties": {
        "_type": {
          "const": "csvImport"
        },
        "location": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/URIOrRef"
        },
        "organization": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/StringOrRef"
        },
        "separator": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/StringOrRef"
        },
        "headers": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/BooleanOrRef"
        },
        "columnNames": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/ListOfStringsOrRef"
        },
        "ncols": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/PositiveIntegerOrRef"
        },
        "nrows": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/PositiveIntegerOrRef"
        },
        "units": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/ListOfStringsOrRef"
        }
      },
      "required": [
        "_type",
        "location"
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/CsvImport"
}
