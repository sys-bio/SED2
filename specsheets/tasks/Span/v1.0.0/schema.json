{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/Span/v1.0.0/schema.json",
  "title": "SED2 Span",
  "$defs": {
    "Span": {
      "description": "A simple start/end range used in BoundedODESimulation and BoundedStochasticSimulation.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        }
      ],
      "properties": {
        "_type": {
          "const": "span",
          "x-rule-id": "Span-0007"
        },
        "start": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "Span-0002",
            "Span-0003"
          ]
        },
        "end": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NumberOrRef",
          "x-rule-id": [
            "Span-0005",
            "Span-0006"
          ]
        }
      },
      "required": [
        "_type",
        "start",
        "end"
      ],
      "x-required-rule-ids": {
        "start": "Span-0001",
        "end": "Span-0004"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Span"
}
