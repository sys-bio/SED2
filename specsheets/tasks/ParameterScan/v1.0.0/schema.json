{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/ParameterScan/v1.0.0/schema.json",
  "title": "SED2 ParameterScan",
  "$defs": {
    "ParameterScan": {
      "description": "Scan a model over one or more ParameterRanges. Inherits from Repeat (subTasks, outputVariableMap, aggregateOutputVariables).",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../tasks/Repeat/v1.0.0/schema.json#/$defs/Repeat"
        }
      ],
      "properties": {
        "_type": {
          "const": "parameterScan",
          "x-rule-id": "ParameterScan-0006"
        },
        "model": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "ParameterScan-0002"
        },
        "parameterRanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../../../tasks/ParameterRange/v1.0.0/inline.schema.json#/$defs/ParameterRangeInline"
          },
          "x-rule-id": "ParameterScan-0004"
        }
      },
      "required": [
        "_type",
        "model",
        "parameterRanges",
        "subTasks"
      ],
      "x-required-rule-ids": {
        "model": "ParameterScan-0001",
        "parameterRanges": "ParameterScan-0003",
        "subTasks": "ParameterScan-0005"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/ParameterScan"
}
