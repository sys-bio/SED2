{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/Range/v1.0.0/schema.json",
  "title": "SED2 Range",
  "$defs": {
    "Range": {
      "description": "A list of values to be taken in sequence. _type is required; may appear as a task or as a named child.",
      "type": "object",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RangeCommon"
        }
      ],
      "properties": {
        "_type": {
          "const": "range",
          "x-rule-id": "Range-0003"
        }
      },
      "required": [
        "_type"
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Range"
}
