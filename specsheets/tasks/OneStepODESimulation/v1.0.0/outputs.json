{
  "outputs": {
    "[id]": {
      "type": "annotatedData",
      "dimensions": [
        {
          "size": {
            "source": "static",
            "expr": "len(outputVariables)"
          },
          "labels": {
            "source": "static",
            "expr": "outputVariables"
          },
          "note": "a single point, not a series"
        }
      ]
    },
    "[id].model": {
      "type": "model"
    }
  }
}
