{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/tasks/ExplicitODESimulation/v1.0.0/schema.json",
  "title": "SED2 ExplicitODESimulation",
  "$defs": {
    "ExplicitODESimulation": {
      "description": "ODE simulation with explicit output points defined by a NumericRange. kisaoID must be KISAO:0000694 (ODE solver) or a child.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        },
        {
          "$ref": "../../../tasks/AbstractTask/v1.0.0/common.schema.json#/$defs/AbstractTaskCommon"
        },
        {
          "$ref": "../../../tasks/AbstractSimulation/v1.0.0/schema.json#/$defs/AbstractSimulation"
        },
        {
          "$ref": "../../../tasks/AbstractODESimulation/v1.0.0/schema.json#/$defs/AbstractODESimulation"
        }
      ],
      "properties": {
        "_type": {
          "const": "explicitODESimulation"
        },
        "independentVariableRange": {
          "$ref": "../../../auxiliary/NumericRange/v1.0.0/inline.schema.json#/$defs/NumericRangeInline"
        }
      },
      "required": [
        "_type",
        "model",
        "independentVariable",
        "outputVariables",
        "independentVariableRange"
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/ExplicitODESimulation"
}
