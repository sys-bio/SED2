{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/auxiliary/LoopVariable/v1.0.0/schema.json",
  "title": "SED2 LoopVariable",
  "$defs": {
    "LoopVariable": {
      "description": "A variable whose value is the initialValue on the first iteration and `subsequentValues` thereafter.",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        }
      ],
      "properties": {
        "initialValue": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/AnyValueOrRef"
        },
        "subsequentValues": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "LoopVariable-0003"
        }
      },
      "required": [
        "initialValue",
        "subsequentValues"
      ],
      "x-required-rule-ids": {
        "initialValue": "LoopVariable-0001",
        "subsequentValues": "LoopVariable-0002"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/LoopVariable"
}
