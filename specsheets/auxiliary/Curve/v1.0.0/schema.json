{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/auxiliary/Curve/v1.0.0/schema.json",
  "title": "SED2 Curve",
  "$defs": {
    "Curve": {
      "description": "A 2D curve on a Plot2D. (AbstractCurve has only one concrete subclass, Curve, so no _type is required.)",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../auxiliary/AbstractCurve/v1.0.0/common.schema.json#/$defs/AbstractCurveCommon"
        }
      ],
      "properties": {
        "_type": {
          "const": "curve",
          "x-rule-id": "Curve-0012"
        },
        "curveType": {
          "anyOf": [
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/CurveType"
            },
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
            }
          ],
          "x-rule-id": [
            "Curve-0002",
            "Curve-0003"
          ]
        },
        "y": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0005"
        },
        "xErrorUpper": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0006"
        },
        "xErrorLower": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0007"
        },
        "yErrorUpper": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0008"
        },
        "yErrorLower": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0009"
        },
        "yFrom": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0010"
        },
        "yTo": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0011"
        }
      },
      "required": [
        "_type",
        "curveType",
        "y"
      ],
      "x-required-rule-ids": {
        "curveType": "Curve-0001",
        "y": "Curve-0004"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Curve"
}
