{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/schemas/auxiliary/Curve/v1.0.0/schema.json",
  "title": "SED2 Curve",
  "$defs": {
    "Curve": {
      "description": "A 2D curve on a Plot2D. (AbstractCurve has only one concrete subclass, Curve, so no _type is required.)",
      "type": "object",
      "allOf": [
        {
          "$ref": "../../../core/SEDBase/v1.0.0/schema.json#/$defs/SEDBaseFields"
        }
      ],
      "properties": {
        "curveType": {
          "anyOf": [
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/CurveType"
            },
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
            }
          ],
          "x-rule-id": [
            "Curve-0002",
            "Curve-0003"
          ]
        },
        "x": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0005"
        },
        "y": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0007"
        },
        "order": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/NonNegativeIntegerOrRef",
          "x-rule-id": [
            "Curve-0008",
            "Curve-0009"
          ]
        },
        "style": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0010"
        },
        "yAxis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "right",
                "left"
              ]
            },
            {
              "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef"
            }
          ],
          "x-rule-id": [
            "Curve-0011",
            "Curve-0018"
          ]
        },
        "xErrorUpper": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0012"
        },
        "xErrorLower": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0013"
        },
        "yErrorUpper": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0014"
        },
        "yErrorLower": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0015"
        },
        "yFrom": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0016"
        },
        "yTo": {
          "$ref": "../../../core/Types/v1.0.0/schema.json#/$defs/SIdRef",
          "x-rule-id": "Curve-0017"
        }
      },
      "required": [
        "curveType",
        "x",
        "y"
      ],
      "x-required-rule-ids": {
        "curveType": "Curve-0001",
        "x": "Curve-0004",
        "y": "Curve-0006"
      },
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/Curve"
}
