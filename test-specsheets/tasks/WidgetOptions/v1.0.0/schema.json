{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sed-ml.org/test-schemas/tasks/WidgetOptions/v1.0.0/schema.json",
  "title": "Test Fixture WidgetOptions",
  "$defs": {
    "WidgetOptions": {
      "description": "Schema-only mixin (composed via allOf, no _type, never referenced as a field type on its own) contributing retry/timeout fields to whichever widgets opt in. Trimmed analog of specsheets/tasks/AbstractSimulation.",
      "type": "object",
      "properties": {
        "retries": {
          "type": "integer",
          "minimum": 0,
          "x-rule-id": "WidgetOptions-0001"
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-rule-id": "WidgetOptions-0002"
        }
      }
    }
  },
  "$ref": "#/$defs/WidgetOptions"
}
