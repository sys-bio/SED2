      "_type": "modelImport",
      "location": "model.xml",
      "language": "urn:sedml:language:sbml"
    },
    "sim1": {
      "_type": "explicitODESimulation",
      "model": "#tasks:m1.model",
      "independentVariable": "time",
      "outputVariables": [
        "S1",
        "S2"
      ],
      "independentVariableRange": {
        "_type": "numericRange",
        "values": [
          0,
          1,
          2,
          3
        ]
      }
    },
    "loop1": {
      "_type": "loop",
      "loopVariables": {
        "lv1": {
          "initialValue": 0,
          "subsequentValues": "#tasks:sim1"
        }
      },
      "subTasks": {
        "s1": {
          "_type": "explicitODESimulation",
          "model": "#tasks:m1.model",
          "independentVariable": "time",
          "outputVariables": [
            "S1",
            "S2"
          ],
          "independentVariableRange": {
            "_type": "numericRange",
            "values": [
              0,
              1,
              2,
              3
            ]
          }
        }
      },
      "range": {
        "_type": "numericRange",
        "values": [
          1,
          2,
          3
        ]
      }
    }
  }
