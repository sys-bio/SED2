{
  "version": "v1.0.0",
  "constants": {
    "k_num": 1.5,
    "k_strings": [
      "a",
      "b"
    ],
    "k_array": [
      10,
      20,
      30
    ],
    "k_obj": {
      "a": 1,
      "b": 2
    },
    "k_str": "hello"
  },
  "tasks": {
