{
  "version": "v1.0.0",
  "constants": {
    "mynumber": 1.3,
    "myNumberArray": [
      1.2,
      2,
      6.6
    ]
  },
  "tasks": {
    "model1": {
      "_type": "modelImport",
      "location": "filename.xml",
      "language": "urn:sedml:language:sbml"
    },
    "loop1": {
      "_type": "loop",
      "loopVariables": {
        "lv1": {
          "initialValue": 0,
          "subsequentValues": "#tasks:loop1:subTasks:sub1.model"
        }
      },
      "subTasks": {
        "sub1": {
          "_type": "modelImport",
          "location": "filename.xml",
          "language": "urn:sedml:language:sbml"
        }
      },
      "outputVariableMap": {
        "col": "#tasks:loop1:subTasks:sub1.model"
      },
      "aggregateOutputVariables": {
        "agg1": {
          "_type": "aggregationCalculation",
          "input": "#constants:mynumber"
        }
      }
    }
  }
}
