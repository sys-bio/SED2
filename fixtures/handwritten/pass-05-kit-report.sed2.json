{
  "version": "v1.0.0",
  "tasks": {
    "m1": {
      "_type": "modelImport",
      "location": "model.xml",
      "language": "urn:sedml:language:sbml"
    },
    "sim1": {
      "_type": "explicitODESimulation",
      "model": "#tasks:m1.model",
      "independentVariable": "time",
      "outputVariables": [
        "S1",
        "S2"
      ],
      "independentVariableRange": {
        "_type": "numericRange",
        "values": [
          0,
          1,
          2,
          3
        ]
      }
    }
  },
  "outputs": {
    "rep1": {
      "_type": "report",
      "data": "#tasks:sim1"
    }
  }
}
