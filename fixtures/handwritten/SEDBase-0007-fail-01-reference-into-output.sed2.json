{
  "version": "v1.0.0",
  "constants": {
    "k_num": 1.5,
    "k_strings": [
      "a",
      "b"
    ],
    "k_array": [
      10,
      20,
      30
    ],
    "k_obj": {
      "a": 1,
      "b": 2
    },
    "k_str": "hello"
  },
  "tasks": {
    "m1": {
      "_type": "modelImport",
      "location": "model.xml",
      "language": "urn:sedml:language:sbml"
    },
    "sim1": {
      "_type": "explicitODESimulation",
      "model": "#tasks:m1.model",
      "independentVariable": "time",
      "outputVariables": [
        "S1",
        "S2"
      ],
      "independentVariableRange": {
        "_type": "numericRange",
        "values": [
          0,
          1,
          2,
          3
        ]
      }
    }
  },
  "outputs": {
    "plot1": {
      "_type": "plot2D",
      "curves": {
        "c1": {
          "_type": "curve",
          "curveType": "points",
          "x": "#tasks:sim1",
          "y": "#tasks:sim1"
        }
      }
    },
    "rep1": {
      "_type": "report",
      "data": "#outputs:plot1:curves:c1"
    }
  }
}
