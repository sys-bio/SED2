{
  "version": "v1.0.0",
  "constants": {
    "k_num": 1.5,
    "k_strings": [
      "a",
      "b"
    ],
    "k_array": [
      10,
      20,
      30
    ],
    "k_obj": {
      "a": 1,
      "b": 2
    },
    "k_str": "hello"
  },
  "tasks": {
    "m1": {
      "_type": "modelImport",
      "location": "model.xml",
      "language": "urn:sedml:language:sbml"
    },
    "c1": {
      "_type": "calculation",
      "math": "1 + #constants:k_num"
    },
    "r1": {
      "_type": "relabelData",
      "input": "#constants:k_array",
      "labels": [
        "#constants:k_str",
        "b"
      ]
    }
  }
}
